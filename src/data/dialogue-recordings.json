{
  "guard": {
    "Gaadi bahar parking ma muki ne aavo.": {
      "url": "/audio/dialogues/guard-d3e5ccb9ce96c6.mp3",
      "spoken": "गाड़ी बाहर पार्किंग मा मूकी ने आवो।",
      "voice": "hi-IN-MadhurNeural"
    },
    "ID kahan hai? ID dikhao.": {
      "url": "/audio/dialogues/guard-420fd2cdb3c76e.mp3",
      "spoken": "आई डी कहाँ है? आई डी दिखाओ।",
      "voice": "hi-IN-MadhurNeural"
    },
    "ID card vagar entry nai male.": {
      "url": "/audio/dialogues/guard-7bc1ec353dda07.mp3",
      "spoken": "आई डी कार्ड वगर एंट्री नई मले।",
      "voice": "hi-IN-MadhurNeural"
    },
    "Virtual visitor pass banavi aapu.": {
      "url": "/audio/dialogues/guard-d5067366885899.mp3",
      "spoken": "वर्चुअल विज़िटर पास बनावी आपूँ।",
      "voice": "hi-IN-MadhurNeural"
    },
    "ID card batavo!": {
      "url": "/audio/dialogues/guard-1670b644093dd9.mp3",
      "spoken": "आई डी कार्ड बतावो!",
      "voice": "hi-IN-MadhurNeural"
    },
    "Aur beta, kaise ho?": {
      "url": "/audio/dialogues/guard-b00262070b6c61.mp3",
      "spoken": "और बेटा, कैसे हो?",
      "voice": "hi-IN-MadhurNeural"
    },
    "Gate ke aage mat khade raho.": {
      "url": "/audio/dialogues/guard-790d34e12eef4d.mp3",
      "spoken": "गेट के आगे मत खड़े रहो।",
      "voice": "hi-IN-MadhurNeural"
    }
  },
  "male": {
