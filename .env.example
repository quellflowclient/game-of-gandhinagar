# Copy to .env and fill in. Leave the Supabase values empty to run in local demo mode.

# --- Browser (public) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: a different URL for the AI endpoint. Defaults to /api/ai.
VITE_AI_ENDPOINT=

# --- Server only (never prefixed with VITE_) ---
# Claude replies for AI twins and AI residents. Without it, offline replies are used.
ANTHROPIC_API_KEY=
# Lets the AI endpoint load twins from the database and log twin chats.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
