# Copy to .env.local and fill in. Empty values use the browser-safe project in src/backend/project.js.
# Vercel: import .env in Project Settings > Environment Variables, then redeploy.

# --- Browser (public) ---
# Optional local-only demo; leave blank for real email-based multiplayer.
VITE_BACKEND=
# Required for live sign-in, profiles, chat and multiplayer.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use an anon key instead. Prefer the publishable key above.
VITE_SUPABASE_ANON_KEY=
# Optional override. Vercel serves the bundled api/ai.js at /api/ai.
VITE_AI_ENDPOINT=/api/ai
# Optional HTTPS endpoint returning short-lived {iceServers:[...]} for mobile/NAT voice calls.
# The endpoint must validate the user's Authorization bearer token. Never expose a TURN admin secret.
VITE_TURN_ENDPOINT=

# --- Server only (never prefixed with VITE_) ---
# Claude replies for AI twins and AI residents. Without it, offline replies are used.
ANTHROPIC_API_KEY=
# Lets the AI endpoint load twins from the database and log twin chats.
# Use the same project URL as VITE_SUPABASE_URL.
SUPABASE_URL=
# Supabase server secret key (sb_secret_...) or legacy service_role key.
# Keep this variable name: api/ai.js reads SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# --- SMTP (private setup values; never prefix with VITE_) ---
# Email sign-in is sent by hosted Supabase Auth, not the Vercel app.
# After filling these in, enter the same values in Supabase Auth > Custom SMTP.
# Adding SMTP_* to .env or Vercel alone does not configure Supabase email delivery.
# Guide: https://supabase.com/docs/guides/auth/auth-smtp
SMTP_HOST=
# Use the port supplied by your email provider (commonly 587 or 465).
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender email must be allowed by your SMTP provider.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="People of Gandhinagar"

# --- Voice relay (Cloudflare Realtime TURN; private server values) ---
# Needed for reliable calls across mobile-data / restrictive NAT networks.
# https://developers.cloudflare.com/realtime/turn/generate-credentials/
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
# Optional override; default is the authenticated local endpoint /api/turn.
VITE_TURN_ENDPOINT=/api/turn
