      "voice": "en-IN-PrabhatNeural"
    },
    "What can people ask you about?": {
      "url": "/audio/dialogues/male-a42b1f20b9d47a.mp3",
      "spoken": "What can people ask you about?",
      "voice": "en-IN-PrabhatNeural"
    },
    "What is the best way to work with you?": {
      "url": "/audio/dialogues/male-9ff6edd58fc75c.mp3",
      "spoken": "What is the best way to work with you?",
      "voice": "en-IN-PrabhatNeural"
    },
    "Tell me one fun Gandhinagar thing about you.": {
      "url": "/audio/dialogues/male-37dab6d8980928.mp3",
