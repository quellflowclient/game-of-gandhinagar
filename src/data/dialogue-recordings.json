      "url": "/audio/dialogues/male-55defe35b1ad1f.mp3",
      "spoken": "अजीत!",
      "voice": "hi-IN-MadhurNeural"
    },
    "કેમ છો! ગાંધીનગરમાં તમારું સ્વાગત છે.": {
      "url": "/audio/dialogues/male-24122c648eb33a.mp3",
      "spoken": "કેમ છો! ગાંધીનગરમાં તમારું સ્વાગત છે.",
      "voice": "gu-IN-NiranjanNeural"
    },
    "એલડીઆરપી": {
      "url": "/audio/dialogues/male-c5e6ead621aa13.mp3",
      "spoken": "એલડીઆરપી",
      "voice": "gu-IN-NiranjanNeural"
    },
    "મહાત્મા મંદિર · દાંડી કુટીર": {
      "url": "/audio/dialogues/male-2704d9006a340a.mp3",
      "spoken": "મહાત્મા મંદિર · દાંડી કુટીર",
      "voice": "gu-IN-NiranjanNeural"
    },
    "કેમ છો! ગાંધીનગરમાં નવા છો? ચાલો, ત્રણ જણને હાથ હલાવીને કેમ છો કહો.": {
      "url": "/audio/dialogues/male-7e455c7eab7e63.mp3",
      "spoken": "કેમ છો! ગાંધીનગરમાં નવા છો? ચાલો, ત્રણ જણને હાથ હલાવીને કેમ છો કહો.",
      "voice": "gu-IN-NiranjanNeural"
    },
    "What do you do, and what are you working on right now?": {
      "url": "/audio/dialogues/male-8475063d50b20e.mp3",
      "spoken": "What do you do, and what are you working on right now?",
      "voice": "en-IN-PrabhatNeural"
    },
    "What are you looking for in Gandhinagar?": {
      "url": "/audio/dialogues/male-e84af68f392c1f.mp3",
